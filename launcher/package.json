{
  "name": "zenith-launcher",
  "productName": "Zenith Client",
  "version": "0.1.0",
  "description": "Zenith Client desktop launcher",
  "private": true,
  "main": "dist-electron/main/index.js",
  "scripts": {
    "dev": "npm run build:main && concurrently -k \"vite\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "vite build",
    "build": "npm run typecheck && npm run build:main && npm run build:renderer",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.renderer.json --noEmit",
    "start": "electron .",
    "test": "vitest run",
    "headless": "tsc -p tsconfig.scripts.json && node dist-electron/scripts-build/scripts/headless-launch.js",
    "dist:win": "npm run build && electron-builder --win",
    "dist:linux": "npm run build && electron-builder --linux"
  },
  "dependencies": {
    "adm-zip": "^0.5.18",
    "skinview3d": "^3.4.2"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.7",
    "@types/node": "^22.20.5",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.2.0",
    "concurrently": "^9.2.0",
    "cross-env": "^10.0.0",
    "electron": "^38.8.6",
    "electron-builder": "^26.17.0",
    "react": "^19.1.10",
    "react-dom": "^19.1.10",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vitest": "^3.2.7",
    "wait-on": "^8.0.0"
  }
}
